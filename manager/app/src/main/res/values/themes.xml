<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KernelSU" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.KernelSU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_window_background</item>
        <!-- The single launch animation is drawn by the in-app splash; a second icon here
             would play a duplicated splash on top of it. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.KernelSU</item>
    </style>

    <style name="Theme.KernelSU.WebUI" parent="Theme.KernelSU">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
