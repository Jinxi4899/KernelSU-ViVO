ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

# preinit runner: a static nolibc binary embedded into kernelsu, see preinit/.
# It is built against the installed UAPI headers of the target kernel
# (CONFIG_HEADERS_INSTALL, enabled by gki_defconfig).
KSU_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
kernelsu-objs += preinit/preinit.o
kernelsu-objs += preinit/blob.o

KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
	-I$(KSU_KERNEL_DIR)/include \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

# The runner is exec'd by PID 1, so it has to load on every page size a
# target can use: the kernel rejects a PT_LOAD whose p_offset and p_vaddr
# disagree modulo PAGE_SIZE (elf_map() computes p_offset - ELF_PAGEOFFSET()
# and vm_mmap() returns -EINVAL for an unaligned offset). ld.lld defaults to
# 4K on x86_64 and 64K on arm64, so pin the maximum and lay the segments out
# contiguously instead of relying on the emulation's default.
KSU_RUNNER_LDFLAGS := -static -nostdlib -e _start --gc-sections -s \
	-z max-page-size=0x10000 -z noseparate-code

quiet_cmd_ksu_runner = RUNNER  $@
      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) $(KSU_RUNNER_LDFLAGS) -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
	$(call if_changed,ksu_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif

obj-$(CONFIG_KSU) += kernelsu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Workaround bazel
# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)

# git refuses to read a repository owned by another user ("dubious ownership").
# That is the normal case inside CI containers, where the checkout and the build
# run as different users. Upstream whitelisted one hard-coded repository path,
# which silently breaks every fork whose repository name differs: the lookup
# fails, the version falls back to a constant, and the resulting module reports
# a version that module installers reject. Always trust the tree we are building.
GIT_SAFE := -c "safe.directory=*"

ifneq ($(GIT),)
# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(GIT) $(GIT_SAFE) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) $(GIT_SAFE) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel, otherwise the commit
# count would be the kernel's history instead of ours.
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) $(GIT_SAFE) rev-list --count HEAD 2>/dev/null)
ifneq ($(KSU_GIT_VERSION),)
KSU_GIT_VERSION_VALID := 1
$(info -- KernelSU: Git repo detected at $(GIT_ROOT))
endif
endif
endif
else
$(warning -- KernelSU: Git not detected, make sure git is installed in your PATH!)
endif


# Calculate version: git commit count if available, else a checked-in
# kernel/ksu_version, else an explicit KSU_VERSION, else fail loudly.
#
# There is deliberately no silent default here. A wrong version is worse than a
# failed build: module installers such as Zygisk Next abort with "KernelSU
# version is too old" below 10940, and a too-high constant makes them abort with
# "KernelSU version abnormal". Builders can always pass KSU_VERSION=<n>.
ifdef KSU_GIT_VERSION_VALID
KSU_VERSION ?= $(shell expr 30000 + $(KSU_GIT_VERSION))
$(info -- KernelSU version: $(KSU_VERSION) (git commit count: $(KSU_GIT_VERSION)))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else ifneq ($(wildcard $(MDIR)/ksu_version),)
KSU_VERSION ?= $(shell cat $(MDIR)/ksu_version)
$(info -- KernelSU version: $(KSU_VERSION) (from $(MDIR)/ksu_version))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else ifdef KSU_VERSION
$(info -- KernelSU version: $(KSU_VERSION) (explicit))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else ifneq ($(filter clean mrproper distclean help menuconfig nconfig xconfig gconfig oldconfig olddefconfig defconfig savedefconfig syncconfig,$(MAKECMDGOALS)),)
# Never block housekeeping or configuration targets.
$(info -- KernelSU version: skipped for $(MAKECMDGOALS))
else ifeq ($(KSU_ALLOW_VERSION_FALLBACK),1)
KSU_VERSION ?= 30000
$(warning -- KernelSU: KSU_VERSION forced to $(KSU_VERSION) by KSU_ALLOW_VERSION_FALLBACK=1)
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else
$(error KernelSU: cannot determine KSU_VERSION: no git metadata and no $(MDIR)/ksu_version. Build with `make KSU_VERSION=<n>`, or write the number into $(MDIR)/ksu_version, or set KSU_ALLOW_VERSION_FALLBACK=1 to build with 30000. Refusing to compile a module that would report a placeholder version.)
endif


KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))

KSU_IS_PR_BUILD ?= 0
ifeq ($(KSU_IS_PR_BUILD),0)
KSU_PACKAGE_NAME ?= me.weishu.kernelsu
else
KSU_PACKAGE_NAME ?= me.weishu.kernelsu.pr
endif
# Certificate of this project's release keystore (DER length 865 bytes),
# extracted from ViVo-KernelSU_1.0.3_32733 and 1.0.4_32740 (both share it).
# Upstream's values were kept here before, which meant a locally built LKM
# refused to crown this Manager. CI overrides both with the values of the APK
# it actually signed, so PR builds keep working.
KSU_EXPECTED_SIZE ?= 0x0361
KSU_EXPECTED_HASH ?= be5a88afbb95657c4caa9c8a7eb2856d62e9c55a98a2aab86be7450cd251e295

$(info -- KernelSU Manager package name: $(KSU_PACKAGE_NAME))
$(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
$(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))
$(info -- KernelSU is PR Build: $(KSU_IS_PR_BUILD))

ccflags-y += -DKSU_PACKAGE_NAME=\"$(KSU_PACKAGE_NAME)\"
ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"
ccflags-y += -DKSU_IS_PR_BUILD=$(KSU_IS_PR_BUILD)

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

